{
    "name": "@nefro/api",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "exports": {
          ".": {
                  "types": "./dist/app.d.ts",
                  "default": "./dist/app.js"
          }
    },
    "scripts": {
