          "express": "^4.21.2"
    },
    "devDependencies": {
          "@types/cookie-parser": "^1.4.7",
          "@types/cors": "^2.8.17",
          "@types/express": "^4.17.21",
          "@types/node": "^22.13.1",
          "prisma": "^6.3.1",
          "tsx": "^4.19.2",
          "typescript": "^5.7.3"
    }
