DATABASE_URL="file:./dev.db"
PORT=3333

# Autenticacao Microsoft Entra ID (Azure AD) / Microsoft Graph
# Preencha os valores abaixo com as credenciais do app registration no Entra ID.
# NAO faca commit de valores reais - este arquivo e so um exemplo.
# Guia completo de onde achar cada valor: docs/entra-id-setup.md

# ID do tenant do Azure AD (Entra ID).
AZURE_TENANT_ID=

# ID do aplicativo (client ID) registrado no Entra ID.
AZURE_CLIENT_ID=

# Segredo do cliente (client secret) gerado para o app registration.
AZURE_CLIENT_SECRET=

# URI de redirecionamento configurada no app registration (fluxo MSAL).
AZURE_REDIRECT_URI=

# Escopos do Microsoft Graph usados na sincronizacao (permissoes de aplicativo).
GRAPH_SCOPES=User.Read.All,Reports.Read.All
